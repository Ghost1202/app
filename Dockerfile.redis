FROM golang:1.16-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN go install github.com/google/wire/cmd/wire@latest && \
    wire ./internal/wired/redis.go && \
    CGO_ENABLED=0 GOOS=linux go build -o /todoapi ./cmd/api

FROM alpine:3.21

RUN apk add --no-cache ca-certificates

COPY --from=builder /todoapi /usr/local/bin/todoapi

EXPOSE 8080

CMD ["todoapi"]
